# DxLens configuration. Every variable is optional; defaults work out of the box.
# Header to parse and serve (default: bundled headers/minifftdx.hpp)
DXLENS_HEADER=headers/minifftdx.hpp
# Extra include dirs (os.pathsep separated) used when compiling snippets
DXLENS_INCLUDE_DIRS=headers
# C++ compiler: g++ or clang++ (default: first one found on PATH)
DXLENS_CXX=
DXLENS_CXXFLAGS=-std=c++17 -Wall
# Seconds allowed for one compile / one run
DXLENS_COMPILE_TIMEOUT=60
DXLENS_RUN_TIMEOUT=10
# Allow check_code(run=true) to execute arbitrary agent-written programs (0/1)
DXLENS_ALLOW_RUN=0

# Optional local-LLM backends for the evaluation harness (no paid API, no keys)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:1.5b
LLAMACPP_URL=http://localhost:8080
